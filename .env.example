# ---- IRC (consumed by mcp_irc_server.py via the generated MCP config) ----
IRC_SERVER=irc.libera.chat        # required
IRC_PORT=6697                     # optional (default 6697)
IRC_TLS=true                      # optional (default true on 6697)
IRC_NICK=omp-bot                  # bot nickname
IRC_USERNAME=                     # optional (default = IRC_NICK)
IRC_REALNAME=                     # optional
IRC_NICKSERV_PASS=                # optional; IDENTIFY on connect (kept 0600 in generated config)
IRC_SERVER_PASS=                  # optional PASS line
IRC_CHANNELS=#ai                  # channels joined on connect (space/comma separated)
IRC_TRUST_HOSTS=o.o 152.53.49.131 # host globs (fnmatch) trusted to trigger the agent;
                                  # seeded into TRUST_FILE (default /state/trust.txt),
                                  # editable at runtime, re-read per message
IRC_IGNORE_NICKS=                 # nicks never surfaced to the agent
IRC_SPOOL_DIR=/state/irc          # message spool + unix socket (volume)
IRC_RING_SIZE=200                 # per-channel in-memory history

# ---- LLM / provider (mapped by entrypoint to the omp-expected env name) ----
LLM_PROVIDER=openrouter           # openrouter|openai|anthropic|gemini|groq|deepseek|mistral|xai|zai|together|fireworks|cerebras|ollama|vllm|lm-studio|openai-compatible
LLM_MODEL=anthropic/claude-haiku  # omp --model value; omit for omp default
LLM_API_KEY=sk-...                # re-exported as e.g. OPENROUTER_API_KEY
LLM_BASE_URL=                     # optional; OpenAI-compatible endpoints only

# ---- Agent workspace ----
OMP_WORKDIR=/state/omp-work       # cwd for omp sessions; .omp/mcp.json generated here
TASKS_DIR=/state/tasks            # durable task queue (queue.jsonl survives restarts)

# ---- Supervisor loop ----
LOOP_POLL_SECONDS=15              # spool poll interval (fast lane)
LOOP_REPLY_IDLE_SECONDS=8         # stdout quiescence treated as end of one IRC reply
